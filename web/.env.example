# Web env (copy to .env.local)

# Host of the eve agent HTTP surface (same Next deploy by default)
EVE_HOST=http://127.0.0.1:3000

# Optional absolute app URL for server-side provider fetches
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# OpenAI / gateway key used by eve (provider depends on your eve project)
# OPENAI_API_KEY=

# Path to raw HackSpain CSVs when regenerating the fact pack
# XRAY_DATA_DIR=../docs/data/raw

# Vercel Blob — durable store for agent recommendation decisions
# (create a Blob store in the Vercel dashboard and paste the token)
# BLOB_READ_WRITE_TOKEN=
