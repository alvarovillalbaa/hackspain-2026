# Web env (copy to .env.local)

# Host of the eve agent HTTP surface (same Next deploy by default)
EVE_HOST=http://127.0.0.1:3000

# Optional absolute app URL for server-side provider fetches
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- LLM credentials (fail-closed; see docs/runbooks/ai-runtime.md) ---
# Helmcode: Eve (chat/marketplace) and AI SDK failover for simple calls.
OPENAI_API_KEY=
# AI SDK (explain / generateStructured): Gateway first, Helmcode if Gateway throws.
# Eve does not fail over. On Vercel, OIDC is enough for Gateway (AI_GATEWAY_API_KEY optional).
# AI_GATEWAY_API_KEY=

# Agentic calibration (optional overrides; see docs/runbooks/calibration.md)
# CALIBRATION_REPS=8
# CALIBRATION_CONCURRENCY=3

# Path to raw HackSpain CSVs when regenerating the fact pack
# XRAY_DATA_DIR=../data/raw

# Python ingest API (uv run xray-api). For Vercel, point at your tunnel URL.
# XRAY_API_URL=http://127.0.0.1:8000

# Vercel Blob — durable store for agent recommendation decisions + imported companies
# (create a Blob store in the Vercel dashboard and paste the token)
# BLOB_READ_WRITE_TOKEN=

# Slack Incoming Webhook for watcher alerts (settings page can also save one)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
